<body>
  <header>
    <h1>Lingerie Boutique</h1>
    <button class="cart-button" aria-label="View shopping cart" id="cartButton">
      🛒 Cart <span class="cart-count" id="cartCount">0</span>
    </button>
  </header>

  <main>
    <section class="add-product-form" aria-label="Add new product">
      <h2>Add New Lingerie Product</h2>
      <form id="newProductForm">
        <div class="form-group">
          <label for="productName">Product Name *</label>
          <input type="text" id="productName" name="productName" required placeholder="Enter product name" />
        </div>
        <div class="form-group">
          <label for="productPrice">Price (USD) *</label>
          <input type="number" id="productPrice" name="productPrice" step="0.01" min="0" required placeholder="Enter price" />
        </div>
        <div class="form-group">
          <label for="productImage">Product Image *</label>
          <input type="file" id="productImage" name="productImage" accept="image/*" required />
          <img id="imagePreview" class="preview-image" alt="Preview of uploaded product image" />
        </div>
        <button type="submit" class="btn-submit" id="submitProduct" disabled>Add Product</button>
      </form>
    </section>

    <section class="products-grid" id="productsGrid" aria-label="Lingerie products">
      <!-- Products will be injected here -->
    </section>
  </main>

  <!-- Cart Modal -->
  <div class="cart-modal" id="cartModal" role="dialog" aria-modal="true" aria-labelledby="cartTitle">
    <div class="cart-content">
      <header class="cart-header">
        <h2 id="cartTitle">Your Cart</h2>
        <button class="cart-close" id="cartClose" aria-label="Close cart">&times;</button>
      </header>
      <section class="cart-items" id="cartItems">
        <!-- Cart items here -->
      </section>
      <div class="cart-total" id="cartTotal">Total: $0.00</div>
    </div>
  </div>

  <script>
    // Sample product data
    let products = [
      {
        id: 1,
        name: 'Elegant Lace Teddy',
        price: 49.99,
        image: 'https://images.unsplash.com/photo-1545289414-49eac3890924?auto=format&fit=crop&w=500&q=60',
      },
      {
        id: 2,
        name: 'Silky Satin Chemise',
        price: 39.99,
        image: 'https://images.unsplash.com/photo-1602810315411-73388c9e2410?auto=format&fit=crop&w=500&q=60',
      },
      {
        id: 3,
        name: 'Sheer Mesh Bra & Panty Set',
        price: 59.99,
        image: 'https://images.unsplash.com/photo-1500883645999-fd7b6a80e1eb?auto=format&fit=crop&w=500&q=60',
      },
      {
        id: 4,
        name: 'Floral Lace Bralette',
        price: 29.99,
        image: 'https://images.unsplash.com/photo-1551434678-e076c223a692?auto=format&fit=crop&w=500&q=60',
      },
      {
        id: 5,
        name: 'Sexy Robe with Satin Belt',
        price: 44.99,
        image: 'https://images.unsplash.com/photo-1590080877777-4aad91937336?auto=format&fit=crop&w=500&q=60',
      },
      {
        id: 6,
        name: 'Vintage Style Corset',
        price: 69.99,
        image: 'https://images.unsplash.com/photo-1550246142-52dad1787aae?auto=format&fit=crop&w=500&q=60',
      }
    ];

    // Cart data: array of { productId, quantity }
    let cart = [];

    // DOM elements
    const productsGrid = document.getElementById('productsGrid');
    const cartButton = document.getElementById('cartButton');
    const cartModal = document.getElementById('cartModal');
    const cartClose = document.getElementById('cartClose');
    const cartItemsContainer = document.getElementById('cartItems');
    const cartCountElem = document.getElementById('cartCount');
    const cartTotalElem = document.getElementById('cartTotal');

    // Add product form elements
    const productNameInput = document.getElementById('productName');
    const productPriceInput = document.getElementById('productPrice');
    const productImageInput = document.getElementById('productImage');
    const imagePreview = document.getElementById('imagePreview');
    const newProductForm = document.getElementById('newProductForm');
    const submitProductButton = document.getElementById('submitProduct');

    // Format number as price string
    function formatPrice(num) {
      return '$' + num.toFixed(2);
    }

    // Render products on page
    function renderProducts() {
      productsGrid.innerHTML = '';
      products.forEach(product => {
        const card = document.createElement('article');
        card.className = 'product-card';
        card.innerHTML = `
          <img class="product-image" src="${product.image}" alt="${product.name}" loading="lazy" />
          <div class="product-info">
            <h3 class="product-name">${product.name}</h3>
            <p class="product-price">${formatPrice(product.price)}</p>
            <button class="btn-add" data-product-id="${product.id}">Add to Cart</button>
          </div>
        `;
        productsGrid.appendChild(card);
      });
    }

    // Update cart count global indicator
    function updateCartCount() {
      const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
      cartCountElem.textContent = totalItems;
      cartCountElem.style.display = totalItems > 0 ? 'inline-block' : 'none';
    }

    // Render cart contents
    function renderCart() {
      cartItemsContainer.innerHTML = '';
      if (cart.length === 0) {
        cartItemsContainer.innerHTML = '<p class="empty-cart">Your cart is empty.</p>';
        cartTotalElem.textContent = 'Total: $0.00';
        return;
      }
      let total = 0;
      cart.forEach(cartItem => {
        const product = products.find(p => p.id === cartItem.productId);
        if (!product) return;

        total += product.price * cartItem.quantity;

        const itemElem = document.createElement('div');
        itemElem.className = 'cart-item';
        itemElem.innerHTML = `
          <img src="${product.image}" alt="${product.name}" />
          <div class="cart-item-details">
            <p class="cart-item-name">${product.name}</p>
            <p class="cart-item-price">${formatPrice(product.price)}</p>
            <div class="cart-item-qty" aria-label="Quantity controls for ${product.name}">
              <button class="qty-btn" data-action="decrease" data-product-id="${product.id}" aria-label="Decrease quantity">-</button>
              <span aria-live="polite" aria-atomic="true" style="min-width: 24px; display: inline-block; text-align:center;">${cartItem.quantity}</span>
              <button class="qty-btn" data-action="increase" data-product-id="${product.id}" aria-label="Increase quantity">+</button>
            </div>
          </div>
        `;
        cartItemsContainer.appendChild(itemElem);
      });
      cartTotalElem.textContent = 'Total: ' + formatPrice(total);
    }

    // Add product to cart
    function addToCart(productId) {
      const item = cart.find(i => i.productId === productId);
      if (item) {
        item.quantity++;
      } else {
        cart.push({ productId, quantity: 1 });
      }
      updateCartCount();
      renderCart();
    }

    // Change quantity in cart
    function changeQuantity(productId, action) {
      const item = cart.find(i => i.productId === productId);
      if (!item) return;

      if (action === 'increase') {
        item.quantity++;
      } else if (action === 'decrease') {
        item.quantity--;
        if (item.quantity <= 0) {
          cart = cart.filter(i => i.productId !== productId);
        }
      }
      updateCartCount();
      renderCart();
    }

    // Validate add product form (enables submit button if all fields valid)
    function validateAddProductForm() {
      const nameOk = productNameInput.value.trim().length > 0;
      const priceOk = parseFloat(productPriceInput.value) > 0;
      const imageOk = productImageInput.files.length > 0;
      submitProductButton.disabled = !(nameOk && priceOk && imageOk);
    }

    // Preview the uploaded image
    productImageInput.addEventListener('change', e => {
      const file = e.target.files[0];
      if (file) {
        const url = URL.createObjectURL(file);
        imagePreview.src = url;
        imagePreview.style.display = 'block';
      } else {
        imagePreview.src = '';
        imagePreview.style.display = 'none';
      }
      validateAddProductForm();
    });

    // Validate inputs live
    productNameInput.addEventListener('input', validateAddProductForm);
    productPriceInput.addEventListener('input', validateAddProductForm);

    // Handle new product form submission
    newProductForm.addEventListener('submit', e => {
      e.preventDefault();

      const name = productNameInput.value.trim();
      const price = parseFloat(productPriceInput.value);
      const file = productImageInput.files[0];

      if (!name || price <= 0 || !file) {
        alert('Please fill all fields correctly.');
        return;
      }

      const imageUrl = URL.createObjectURL(file);

      // Generate new unique product ID
      const newId = products.length > 0 ? Math.max(...products.map(p => p.id)) + 1 : 1;

      // Create new product object
      const newProduct = {
        id: newId,
        name: name,
        price: price,
        image: imageUrl
      };

      products.push(newProduct);
      renderProducts();

      // Reset form
      newProductForm.reset();
      imagePreview.src = '';
      imagePreview.style.display = 'none';
      submitProductButton.disabled = true;

      alert('Product added successfully!');
    });

    // Event listeners
    productsGrid.addEventListener('click', e => {
      if (e.target.classList.contains('btn-add')) {
        const productId = parseInt(e.target.dataset.productId, 10);
        addToCart(productId);
      }
    });

    cartButton.addEventListener('click', () => {
      renderCart();
      cartModal.classList.add('active');
    });

    cartClose.addEventListener('click', () => {
      cartModal.classList.remove('active');
    });

    cartModal.addEventListener('click', e => {
      if (e.target === cartModal) {
        cartModal.classList.remove('active');
      }
    });

    cartItemsContainer.addEventListener('click', e => {
      if (e.target.classList.contains('qty-btn')) {
        const productId = parseInt(e.target.dataset.productId, 10);
        const action = e.target.dataset.action;
        changeQuantity(productId, action);
      }
    });

    // Initialize display
    updateCartCount();
    renderProducts();
  </script>
</body>
</html>

